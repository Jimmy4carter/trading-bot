# ========================================================
# TRADING BOT CONFIGURATION
# ========================================================

# Execution Environment: 'demo' (True Paper Trading on Live Feeds) or 'live' (Real Money)
EXECUTION_MODE=demo

# Active Default Broker: 'bybit', 'binance', or 'oanda'
ACTIVE_BROKER=bybit

# Portfolio & Risk Limits
STARTING_BALANCE_USD=10.0
TRADE_SIZE_USD=10.0
MAX_CONCURRENT_TRADES=3
MIN_CONFIDENCE_THRESHOLD=0.65
MAX_DAILY_DRAWDOWN_PCT=3.0

# Scalping & Dynamic Exit Settings
TAKE_PROFIT_PCT=0.015       # 1.5% take profit
STOP_LOSS_PCT=0.006         # 0.6% hard stop loss
TRAILING_ACTIVATION_PCT=0.008 # 0.8% profit triggers trailing stop
TRAILING_PULLBACK_PCT=0.0025  # 0.25% pullback from high triggers exit

# Crypto Exchange Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Forex Broker Credentials (OANDA v20)
OANDA_API_KEY=your_oanda_practice_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice  # 'practice' or 'trade'

# Storage & Cache
SQLITE_DB_PATH=trading_ledger.db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_UNIX_SOCKET=/var/run/redis/redis.sock
REDIS_DB=0

# Security & Dashboard Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Server Settings
HOST=0.0.0.0
PORT=8000
